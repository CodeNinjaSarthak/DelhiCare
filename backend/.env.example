# ─────────────────────────────────────────────────────────────────────────────
# DelhiCare — Backend Environment Variables
#
# Copy this file to .env and fill in real values before running the server.
# The server validates these at startup and exits with a clear error if required
# vars are missing (see backend/utils/validateEnv.js).
#
# NEVER commit .env to version control — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────

NODE_ENV=development
# Accepted values: development | production | test

PORT=4000
# The port the Express server listens on.
# In Docker Compose, this is overridden by the compose file.

LOG_LEVEL=info
# Accepted values: error | warn | info | http | verbose | debug | silly
# Use "debug" locally if you need verbose output.

# ── Database ─────────────────────────────────────────────────────────────────

MONGO_URL=
# Local:      mongodb://localhost:27017/delhicare
# Docker:     mongodb://mongo:27017/delhicare  (set automatically by compose)
# Atlas:      mongodb+srv://<user>:<pass>@cluster.mongodb.net/delhicare

# ── Auth ─────────────────────────────────────────────────────────────────────

JWT_SECRET=
# SECURITY: must be at least 32 characters. Use a randomly generated value in
# production, e.g.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Twilio (SMS) ──────────────────────────────────────────────────────────────
# Required for OTP registration and discharge/allocation SMS notifications.
# Leave blank during local development if you don't need SMS — the server
# starts without them but SMS calls will fail at runtime.

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
